{
  "name": "@fomo/tui",
  "version": "0.1.1",
  "description": "FOMO terminal UI",
  "private": true,
  "type": "module",
  "bin": {
    "fomo": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fomo/core": "workspace:*",
    "@github/copilot-sdk": "^1.0.15",
    "ink": "^5.1.0",
    "open": "^10.1.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.0",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
