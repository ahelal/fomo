# =============================================================================
# FOMO - Environment Variables (all optional — the TUI config screen (`fomo`, then c) is preferred)
# Copy to .env and fill in values.
# =============================================================================

# Azure Table Storage connection string (fallback when ~/.fomo/config.json has none).
# Local dev with Azurite: UseDevelopmentStorage=true
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# URL of the deployed web app, used by "Link a device" (overrides the config file).
# FOMO_WEB_URL=https://<account>.z1.web.core.windows.net/

# Copilot model used for the digest (overrides the config file; default gpt-5-mini).
# FOMO_COPILOT_MODEL=gpt-5-mini

# Interests note that nudges digest importance up or down (overrides the config file).
# FOMO_INTERESTS=Copilot CLI and agents, VS Code; not SAP or billing

# GitHub token for the Copilot SDK. Optional: without it the logged-in Copilot CLI user is used.
# COPILOT_GITHUB_TOKEN=
